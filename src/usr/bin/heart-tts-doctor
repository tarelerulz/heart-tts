#!/bin/sh
# Quick health check for heart-tts: engine, models, runtime deps, and a 1-line
# synthesis self-test. Exit 1 if speech cannot be produced.
PREFIX=/opt/heart-tts
ok(){   printf '  [ ok ] %s\n' "$1"; }
bad(){  printf '  [FAIL] %s\n' "$1"; FAIL=$((FAIL+1)); }
warn(){ printf '  [warn] %s\n' "$1"; WARN=$((WARN+1)); }
FAIL=0; WARN=0

echo "Engine"
if [ -x "$PREFIX/build/bin/audiocpp_cli" ]; then ok "engine present: $PREFIX/build/bin/audiocpp_cli"; else bad "engine missing: $PREFIX/build/bin/audiocpp_cli"; fi

echo "Voice models"
for m in sanoTTS-heart-GGUF/heart-f32.gguf sanoTTS-heart-nano-GGUF/heart-nano-f32.gguf; do
  if [ -f "$PREFIX/models/$m" ]; then ok "model: $m"; else bad "model missing: $m"; fi
done

echo "Engines (choose with HEART_ENGINE=auto|gpu|cpu-neon|cpu-fp16-pw|cpu-fp16|cpu-dotprod16|cpu-dotprod|cpu-dotprod-fp16, or the engine menu in Read Aloud)"
want="${HEART_ENGINE:-}"
[ -z "$want" ] && [ -f "$HOME/.config/heart-tts/engine" ] && want=$(cat "$HOME/.config/heart-tts/engine")
[ -z "$want" ] && want=auto
echo "  requested engine: $want"
if [ -x "$PREFIX/build/bin/hn-fast" ]; then ok "cpu-neon: heart-nano -> hn-fast (hand-written CPU path)"; else warn "cpu-neon: hn-fast missing, heart-nano falls back to audio.cpp (slower)"; fi
ok "cpu-neon: heart -> audio.cpp engine (NEON decoder; heart has no GPU engine)"
GPUWHY=""
grep -qil v3d /sys/class/drm/*/device/uevent 2>/dev/null || GPUWHY="no V3D GPU found"
[ -z "$GPUWHY" ] && for f in hn-gpu-plan.bin libhngpu.so shaders; do [ -e "$PREFIX/gpu/$f" ] || GPUWHY="GPU files missing ($f)"; done
[ -z "$GPUWHY" ] && ! ls /dev/dri/renderD* >/dev/null 2>&1 && GPUWHY="no /dev/dri/renderD* node"
[ -z "$GPUWHY" ] && { for n in /dev/dri/renderD*; do [ -r "$n" ] && [ -w "$n" ] && GPUOK=1; done; [ -z "$GPUOK" ] && GPUWHY="no access to /dev/dri/renderD* (add yourself to the 'render' group, then log in again)"; }
[ -z "$GPUWHY" ] && ! ldconfig -p 2>/dev/null | grep -q "libvulkan.so.1" && GPUWHY="libvulkan1 missing  -> sudo apt install libvulkan1 mesa-vulkan-drivers"
if [ -z "$GPUWHY" ]; then ok "gpu: available (heart-nano decoder on the V3D GPU; needs less CPU, not faster)"; else warn "gpu: not available - $GPUWHY (heart-nano stays on cpu-neon)"; fi
FEAT=$(grep -m1 "^Features" /proc/cpuinfo 2>/dev/null)
HAVE_FP16=""; HAVE_DOT=""
case "$FEAT" in *asimdhp*) HAVE_FP16=1;; esac
case "$FEAT" in *asimddp*) HAVE_DOT=1;; esac
tier() { # name needs-fp16 needs-dotprod note
  miss=""
  [ "$2" = 1 ] && [ -z "$HAVE_FP16" ] && miss="fp16"
  [ "$3" = 1 ] && [ -z "$HAVE_DOT" ] && miss="$miss${miss:+ + }dot-product"
  if [ -z "$miss" ]; then ok "$1: available (opt-in, not the default; $4)"; else warn "$1: not available - this CPU has no $miss support (Pi 5 / newer phones do); falls back to cpu-neon"; fi
}
tier cpu-fp16-pw 1 0 "heart ~1.3x, nano ~1.1x; small accuracy trade"
tier cpu-fp16 1 0 "heart ~1.5x, nano ~1.15x; small accuracy trade"
tier cpu-dotprod16 0 1 "heart-nano only, near-lossless, ~1.1x"
tier cpu-dotprod 0 1 "heart ~1.4x, nano ~1.25x; small accuracy trade"
tier cpu-dotprod-fp16 1 1 "heart ~1.6x, nano ~1.3x; small accuracy trade"
case "$want" in
  auto) ok "auto -> cpu-neon (fastest exact engine here)";;
  cpu-neon) ok "selected: cpu-neon";;
  cpu-fp16-pw|cpu-fp16|cpu-dotprod16|cpu-dotprod|cpu-dotprod-fp16) ok "selected: $want (falls back to cpu-neon if this CPU lacks the feature)";;
  gpu) if [ -z "$GPUWHY" ]; then ok "selected: gpu (heart-nano; heart still uses cpu-neon)"; else warn "selected: gpu but unavailable, will use cpu-neon"; fi;;
  *) warn "unknown HEART_ENGINE '$want' (use auto, gpu, cpu-neon or one of the cpu-fp16/cpu-dotprod tiers); using auto";;
esac

echo "Runtime"
command -v python3 >/dev/null 2>&1 && ok "python3" || bad "python3 missing"
python3 -c "import numpy" 2>/dev/null && ok "python3-numpy" || bad "python3-numpy missing  -> sudo apt install python3-numpy"
python3 -c "import tkinter" 2>/dev/null && ok "python3-tk (Read Aloud window)" || warn "python3-tk missing (CLI heart-say still works)  -> sudo apt install python3-tk"
[ -f /lib/aarch64-linux-gnu/libespeak-ng.so.1 ] && ok "libespeak-ng" || bad "libespeak-ng missing  -> sudo apt install libespeak-ng1"
[ -d /usr/lib/aarch64-linux-gnu/espeak-ng-data ] && ok "espeak-ng-data" || bad "espeak-ng-data missing  -> sudo apt install espeak-ng-data"
command -v ffmpeg >/dev/null 2>&1 && ok "ffmpeg (clarity leveler + speed)" || bad "ffmpeg missing  -> sudo apt install ffmpeg"
command -v wl-paste >/dev/null 2>&1 && ok "wl-clipboard (reads highlighted text)" || warn "wl-paste missing  -> sudo apt install wl-clipboard"
if command -v pw-play >/dev/null 2>&1; then ok "pw-play (PipeWire playback)"; elif command -v aplay >/dev/null 2>&1; then warn "pw-play missing; will use aplay (no mixing with other audio)"; else bad "no pw-play or aplay  -> sudo apt install pipewire-bin (or alsa-utils)"; fi

echo "Self-test (synthesize 'testing' to a temp file)"
TMP=$(mktemp --suffix=.wav)
if HEART_TEXT="testing one two three" python3 "$PREFIX/read_heart.py" heart-nano 1.0 >/dev/null 2>&1; then
  ok "engine produced speech"
else
  bad "synthesis self-test failed (run:  HEART_TEXT=hi python3 $PREFIX/read_heart.py heart-nano  to see the error)"
fi
rm -f "$TMP"

echo
if [ "$FAIL" -gt 0 ]; then echo "Result: $FAIL problem(s), $WARN warning(s). Read-aloud will not work until the [FAIL] lines are fixed."; exit 1
else echo "Result: ready ($WARN warning(s))."; fi
